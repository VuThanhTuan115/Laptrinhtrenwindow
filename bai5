using System.Drawing.Text;
using System.Windows.Forms.Design;

namespace Soạn_Thảo_Văn_Bản
{
    public partial class frmSoanThao : Form
    {
        string fileName = " ";
        public frmSoanThao()
        {
            InitializeComponent();
        }
        private void frmSoanThao_Load(object sender, EventArgs e)
        {
            //Font 
            foreach (FontFamily font in new InstalledFontCollection().Families)
            {
                cmbFonts.Items.Add(font.Name);
            }
            //Size 
            int[] size = { 8, 9, 10, 11, 12, 14, 16, 18, 20, 22, 24, 26, 28, 36, 48, 72 };
            foreach (int s in size)
            {
                cmbSize.Items.Add(s);
            }
            //Mặc định 
            cmbFonts.Text = "Tahoma";
            cmbSize.Text = "14";
            rtbVanBan.Font = new Font("Tahoma", 14);
        }
        private void rtbVanBan_TextChanged(object sender, EventArgs e)
        {
        }
        //Tạo văn bản mới
        private void tslTaoVanBan_Click(object sender, EventArgs e)
        {
            rtbVanBan.Clear();
            cmbFonts.Text = "Tahoma";
            cmbSize.Text = "14";
            rtbVanBan.Font = new Font("Tahoma", 14);
        }
        //Lưu tập tin
        private void tslLuu_Click(object sender, EventArgs e)
        {
            SaveFileDialog save = new SaveFileDialog();
            save.Filter = "Rich Text Format (*.rtf)|*.rtf";
            if (save.ShowDialog() == DialogResult.OK)
            {
                rtbVanBan.SaveFile(save.FileName, RichTextBoxStreamType.RichText);
                MessageBox.Show("Lưu thành công!");
            }
        }
        //Mở tập tin
        private void tslMoTapTin_Click(object sender, EventArgs e)
        {
            OpenFileDialog openFileDialog = new OpenFileDialog();
            openFileDialog.Filter = "Tập tin văn bản (*.txt;*.rtf)|*.txt;*.rtf|" + "Rich Text Format (*.rtf)|*.rtf" + "Text File (*.txt)|*.txt";
            if (openFileDialog.ShowDialog() == DialogResult.OK)
            {
                //Lưu đường dẫn tập tin được chọn vào biến fileName
                string fileName = openFileDialog.FileName;
                string extension = Path.GetExtension(fileName).ToLower();
                if (extension == ".txt")
                {
                    rtbVanBan.LoadFile(fileName, RichTextBoxStreamType.PlainText);
                }
                else if (extension == ".rtf")
                {
                    rtbVanBan.LoadFile(fileName, RichTextBoxStreamType.RichText);
                }
                else
                {
                    MessageBox.Show("Định dạng tập tin không được hỗ trợ.", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }
        //Thoát 
        private void tslThoat_Click(object sender, EventArgs e)
        {
            Application.Exit();
        }
        private void tslHeThong_Click(object sender, EventArgs e)
        {
        }
        private void btnMoTapTin_Click(object sender, EventArgs e)
        {
            tslMoTapTin_Click(sender, e);
        }
        // B - In đậm 
        private void tslB_Click(object sender, EventArgs e)
        {
            if (rtbVanBan.SelectionFont != null)
            {
                Font f = rtbVanBan.SelectionFont;
                if (f.Bold)
                {
                    rtbVanBan.SelectionFont = new Font(f, FontStyle.Regular);
                }
                else
                {
                    rtbVanBan.SelectionFont = new Font(f, FontStyle.Bold);
                }
            }
        }
        // I - In nghiêng
        private void tslI_Click(object sender, EventArgs e)
        {
            if (rtbVanBan.SelectionFont != null)
            {
                Font f = rtbVanBan.SelectionFont;
                if (f.Italic)
                {
                    rtbVanBan.SelectionFont = new Font(f, FontStyle.Regular);
                }
                else
                {
                    rtbVanBan.SelectionFont = new Font(f, FontStyle.Italic);
                }
            }
        }
        // U - Gạch chân
        private void tslU_Click(object sender, EventArgs e)
        {
            if (rtbVanBan.SelectionFont != null)
            {
                Font f = rtbVanBan.SelectionFont;
                if (f.Underline)
                {
                    rtbVanBan.SelectionFont = new Font(f, FontStyle.Regular);
                }
                else
                {
                    rtbVanBan.SelectionFont = new Font(f, FontStyle.Underline);
                }
            }
        }
        private void cmbFonts_Click(object sender, EventArgs e)
        {
            FontDialog font = new FontDialog();
            if (font.ShowDialog() == DialogResult.OK)
            {
                rtbVanBan.SelectionFont = font.Font;
                rtbVanBan.SelectionColor = font.Color;
            }
        }
        //Size
        private void cmbSize_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (rtbVanBan.SelectionFont != null)
            {
                float size = Convert.ToSingle(cmbSize.SelectedItem);
                string fontName = "Tahoma";
                if (rtbVanBan.SelectionFont != null)
                {
                    fontName = rtbVanBan.SelectionFont.Name;
                }
                rtbVanBan.SelectionFont = new Font(fontName, size);
            }
        }
        //Font
        private void cmbFonts_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (cmbFonts.SelectedItem != null)
            {
                float size = 14;
                if (rtbVanBan.SelectionFont != null)
                {
                    size = rtbVanBan.SelectionFont.Size;
                }
                rtbVanBan.SelectionFont = new Font(cmbFonts.SelectedItem.ToString(), size);
            }
        }
        private void tslFont_Click_1(object sender, EventArgs e)
        {
            FontDialog fontDlg = new FontDialog();
            fontDlg.ShowColor = true;
            fontDlg.ShowEffects = true;
            if (fontDlg.ShowDialog() == DialogResult.OK)
            {
                rtbVanBan.Font = fontDlg.Font;
                rtbVanBan.ForeColor = fontDlg.Color;
            }
        }
    }
}

